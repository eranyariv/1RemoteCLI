<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Protocol\1RemoteCLI.Protocol.csproj" />
    <ProjectReference Include="..\Terminal\1RemoteCLI.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The token cache's encrypt/decrypt path is internal but is the security
         control worth testing directly, rather than through MSAL. -->
    <InternalsVisibleTo Include="1RemoteCLI.Daemon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- A separate container from the exe icon, and a transparent one. It carries
         mark-only frames at 16, 20, 24, 32, 40 and 48, so the tray can ask for
         whatever size the shell wants and get a real frame rather than a stretched
         one. The exe icon keeps its black tile, which is what makes the artwork read
         as a terminal, but the shell composites a tray icon straight onto the
         taskbar, where an opaque tile would be a black box. -->
    <EmbeddedResource Include="..\..\assets\1remote-tray.ico" LogicalName="1RemoteCLI.Tray.Logo.ico" />

    <!-- One container per live-session count, plus a ">9" for everything above them
         (issue #76). Shipping eleven drawn variants rather than compositing a digit at
         run time is what makes the number legible at 16 pixels; see TrayArtwork and
         scripts/make-icons.ps1, which generates all of them from assets/tray. -->
    <EmbeddedResource Include="..\..\assets\1remote-tray-1.ico" LogicalName="1RemoteCLI.Tray.Count.1.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-2.ico" LogicalName="1RemoteCLI.Tray.Count.2.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-3.ico" LogicalName="1RemoteCLI.Tray.Count.3.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-4.ico" LogicalName="1RemoteCLI.Tray.Count.4.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-5.ico" LogicalName="1RemoteCLI.Tray.Count.5.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-6.ico" LogicalName="1RemoteCLI.Tray.Count.6.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-7.ico" LogicalName="1RemoteCLI.Tray.Count.7.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-8.ico" LogicalName="1RemoteCLI.Tray.Count.8.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-9.ico" LogicalName="1RemoteCLI.Tray.Count.9.ico" />
    <EmbeddedResource Include="..\..\assets\1remote-tray-more.ico" LogicalName="1RemoteCLI.Tray.Count.More.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.28" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
    <!-- Draws the tray icon. Worth checking before adding anything here: this package
         is GDI+ and nothing else, so it does not pull in the Windows Desktop runtime
         the way a Windows Forms reference does. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>1remote</AssemblyName>
    <!-- Drives the taskbar, Alt-Tab, Explorer and the Start-menu shortcut, all
         from the exe itself, so the shortcut needs no explicit icon location.
         The tray uses the same artwork, with a status badge composited on top -
         see TrayArtwork. -->
    <ApplicationIcon>..\..\assets\1remote.ico</ApplicationIcon>
    <RootNamespace>OneRemoteCli.Daemon</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required by the LibraryImport source generator used for the ConPTY and tray P/Invokes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Not WinExe, deliberately: the same binary is the wrapper, and a
         windows-subsystem process has no stdout to write a terminal to. The agent
         hides its own console instead.

         There is no UseWindowsForms here either. It was referenced for the tray icon
         alone and cost about 40 MB of Windows Desktop runtime in every download; the
         tray now calls Shell_NotifyIcon directly. See TrayIcon and issue #46. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 1remote is a wrapper you drop on your PATH, so its download size is a feature.
         Removing Windows Forms took it from 70 MB to 35; trimming takes it to 13.

         Trim warnings are errors here (TreatWarningsAsErrors, above), which is the
         point. The failures trimming causes are silent ones at run time: a settings
         file that stops being read, a machine identity that regenerates itself and
         takes the user's paired machine with it. They are only cheap to prevent while
         the compiler is still telling us where reflection is being used, which is why
         the JSON in this project is source-generated.

         ILLink reports our own assemblies and project references site by site, and
         collapses each NuGet package to a single IL2104. IL2104 is suppressed because
         MessagePack builds its formatters with Reflection.Emit and SignalR reflects
         over hub signatures, so both are unanalysable by construction and there is
         nothing we can do about it from here. Suppressing only the rollup keeps every
         warning about code we can actually fix. See the roots below for how the risk
         those two libraries do carry is handled. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kept whole rather than trimmed. MessagePack picks its formatters by
         reflecting over its own resolvers and then emits accessors for the members of
         our wire types, none of which ILLink can see, so a member the linker judged
         unreachable would come back as a serialization failure on one message type on
         a user's machine. Protocol is a project reference and would not be trimmed in
         partial mode anyway; it is listed because being explicit about which types the
         wire format depends on is worth more than the line costs.

         Together these are worth a little over a megabyte, against a 22 MB saving. -->
    <TrimmerRootAssembly Include="MessagePack" />
    <TrimmerRootAssembly Include="1RemoteCLI.Protocol" />
  </ItemGroup>

</Project>
