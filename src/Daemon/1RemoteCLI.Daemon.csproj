<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Protocol\1RemoteCLI.Protocol.csproj" />
    <ProjectReference Include="..\Terminal\1RemoteCLI.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The token cache's encrypt/decrypt path is internal but is the security
         control worth testing directly, rather than through MSAL. -->
    <InternalsVisibleTo Include="1RemoteCLI.Daemon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- A separate container from the exe icon, and a transparent one. It carries
         mark-only frames at 16, 20, 24, 32, 40 and 48, so the tray can ask for
         whatever size the shell wants and get a real frame rather than a stretched
         one. The exe icon keeps its black tile, which is what makes the artwork read
         as a terminal, but the shell composites a tray icon straight onto the
         taskbar, where an opaque tile would be a black box. -->
    <EmbeddedResource Include="..\..\assets\1remote-tray.ico" LogicalName="1RemoteCLI.Tray.Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.28" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" Version="8.0.28" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.66.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>1remote</AssemblyName>
    <!-- Drives the taskbar, Alt-Tab, Explorer and the Start-menu shortcut, all
         from the exe itself, so the shortcut needs no explicit icon location.
         The tray uses the same artwork, with a status badge composited on top -
         see TrayArtwork. -->
    <ApplicationIcon>..\..\assets\1remote.ico</ApplicationIcon>
    <RootNamespace>OneRemoteCli.Daemon</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Required by the LibraryImport source generator used for the ConPTY P/Invokes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- For the tray icon only (spec §4.2). Deliberately NOT WinExe: the same binary
         is the wrapper, and a windows-subsystem process has no stdout to write a
         terminal to. The agent hides its own console instead. -->
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
