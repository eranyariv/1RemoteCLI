<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OneRemoteCli.Daemon.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hub client is tested against a real SignalR server on a real socket,
         which needs the ASP.NET Core shared framework in the test host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daemon\1RemoteCLI.Daemon.csproj" />
    <ProjectReference Include="..\..\src\Protocol\1RemoteCLI.Protocol.csproj" />

    <!-- The end-to-end test drives the real hub, not a stand-in. Referencing a web
         project from a test project is unusual, but the alternative is a copy of the
         hub's wiring that can drift from the thing being shipped — which is exactly
         the class of bug this test exists to catch. -->
    <ProjectReference Include="..\..\src\Hub\1RemoteCLI.Hub.csproj" />

    <!-- The scripted CLI, built alongside and copied in. The latency measurements
         need a program that reports the instant a keystroke reached it, which no
         shell will do. -->
    <ProjectReference Include="..\E2E.Script\1RemoteCLI.E2E.Script.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
