<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>OneRemoteCli.E2E.Host</RootNamespace>
    <AssemblyName>1remote-e2e-host</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>

    <!-- Windows-only because it hosts a real agent driving a real pseudoconsole.
         ConPTY has no equivalent elsewhere, which is why the Playwright job runs on
         a Windows runner rather than the ubuntu one the rest of the app uses. -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Daemon\1RemoteCLI.Daemon.csproj" />
    <ProjectReference Include="..\..\src\Hub\1RemoteCLI.Hub.csproj" />
    <ProjectReference Include="..\..\src\Protocol\1RemoteCLI.Protocol.csproj" />

    <!-- Built alongside, and copied in, so the host can start it without the test
         knowing where either of them landed. -->
    <ProjectReference Include="..\E2E.Script\1RemoteCLI.E2E.Script.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Content"
                      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
