<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OneRemoteCli.E2E.Script</RootNamespace>
    <AssemblyName>1remote-e2e-script</AssemblyName>
